{"extract:173739a0566acf35b40c1eb3430f36be": [{"text": "WERNHAM HOGG PAPER MERCHANTS", "kind": "organisation", "context": "INT. WERNHAM HOGG PAPER MERCHANTS - SLOUGH - DAY"}, {"text": "JACK DAWSON", "kind": "person", "context": "JACK DAWSON, 40s, tie askew, stares at a vending machine."}, {"text": "MARIA SOLBERG", "kind": "person", "context": "MARIA SOLBERG, 30s, doesn't look up from her monitor."}, {"text": "Blue Sun Corporation", "kind": "organisation", "context": "I bought shares in Blue Sun Corporation on your advice, Jack."}, {"text": "Wetherspoons", "kind": "organisation", "context": "That was a tip from a man in a Wetherspoons."}, {"text": "THE GATHERING", "kind": "title", "context": "Maria slides him a DVD: THE GATHERING."}, {"text": "Ealing Studios", "kind": "organisation", "context": "Ealing Studios wants it remade."}], "exposure2:Blue_Sun_Corporation|Ealing_Studios|Jack_Dawson|Maria_Solberg|The_Gathering|Wernham_Hogg_Paper_Merchants|Wetherspoons": {"territory": [["Wetherspoons", "en", 176581], ["Ealing_Studios", "en", 37920], ["Jack_Dawson", "es", 14952], ["Jack_Dawson", "pt", 12006], ["The_Gathering", "ru", 8731], ["Jack_Dawson", "en", 4680], ["The_Gathering", "no", 3729], ["The_Gathering", "en", 3543], ["The_Gathering", "fi", 2892], ["Ealing_Studios", "de", 2163], ["Ealing_Studios", "fr", 1606], ["Wetherspoons", "it", 1344], ["Ealing_Studios", "ru", 1168], ["Wetherspoons", "zh", 950], ["The_Gathering", "el", 846], ["Wetherspoons", "simple", 733], ["The_Gathering", "uk", 679], ["Ealing_Studios", "it", 512], ["The_Gathering", "de", 472], ["The_Gathering", "he", 261], ["The_Gathering", "pt", 237], ["The_Gathering", "nl", 226], ["Ealing_Studios", "nl", 217], ["The_Gathering", "es", 210], ["The_Gathering", "fr", 204], ["Ealing_Studios", "es", 179], ["Ealing_Studios", "sv", 173], ["The_Gathering", "nn", 168], ["Ealing_Studios", "fi", 162], ["Jack_Dawson", "nl", 142], ["The_Gathering", "sk", 139], ["Jack_Dawson", "fr", 129], ["The_Gathering", "pl", 122], ["Eal