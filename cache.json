_name, count() AS credits\nFROM imdb.roles\nINNER JOIN imdb.actors ON imdb.actors.id = imdb.roles.actor_id\nWHERE lower(first_name) = lower('JACK')\n  AND lower(last_name) = lower('DAWSON')\nGROUP BY first_name, last_name ORDER BY credits DESC LIMIT 5": [["Jack", "Dawson", 3]], "SELECT first_name, last_name, count() AS credits\nFROM imdb.roles\nINNER JOIN imdb.actors ON imdb.actors.id = imdb.roles.actor_id\nWHERE lower(first_name) = lower('MARIA')\n  AND lower(last_name) = lower('SOLBERG')\nGROUP BY first_name, last_name ORDER BY credits DESC LIMIT 5": [], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bBlue\\\\s+Sun\\\\s+Corporation\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bWetherspoons\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "SELECT name, year, rank, (lower(name) = lower('THE GATHERING') OR lower(name) = lower('GATHERING, The')) AS exact\nFROM imdb.movies\nWHERE (positionCaseInsensitive(name, 'THE GATHERING') > 0 OR positionCaseInsensitive(name, 'GATHERING, The') > 0) AND year > 1800\nORDER BY exact DESC, rank DESC, year DESC LIMIT 6": [["Gathering, The", 2002, 5.800000190734863, 1], ["Gathering, The", 1998, 4.5, 1], ["Gathering, The", 1977, 0.0, 1], ["Magic the Gathering: Battlegrounds", 2003, 0.0, 0], ["McAllister Affair: The Gathering", 2002, 0.0, 0], ["Children of the Corn IV: The Gathering", 1996, 0.0, 0]], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bEaling\\\\s+Studios\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": []}