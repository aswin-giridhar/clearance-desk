{"extract:aad19796ddbc82d935d00ce6716fb147": [{"text": "WERNHAM HOGG PAPER MERCHANTS", "kind": "organisation", "context": "INT. WERNHAM HOGG PAPER MERCHANTS - SLOUGH - DAY"}, {"text": "JACK DAWSON", "kind": "person", "context": "JACK DAWSON, 40s, tie askew, stares at a vending machine."}, {"text": "MARIA SOLBERG", "kind": "person", "context": "MARIA SOLBERG, 30s, doesn't look up from her monitor."}, {"text": "Blue Sun Corporation", "kind": "organisation", "context": "I bought shares in Blue Sun Corporation on your advice, Jack."}, {"text": "Wetherspoons", "kind": "organisation", "context": "That was a tip from a man in a Wetherspoons."}, {"text": "THE GATHERING", "kind": "title", "context": "Maria slides him a DVD: THE GATHERING."}, {"text": "Ealing Studios", "kind": "organisation", "context": "Ealing Studios wants it remade."}], "prom:Blue_Sun_Corporation|Ealing_Studios|Jack_Dawson|Maria_Solberg|The_Gathering|Wernham_Hogg_Paper_Merchants|Wetherspoons": [["Ealing_Studios", 44510, 24], ["Jack_Dawson", 32061, 12], ["The_Gathering", 23092, 38], ["Wetherspoons", 179651, 10], ["Blue_Sun_Corporation", 16, 1]], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bWERNHAM\\\\s+HOGG\\\\s+PAPER\\\\s+MERCHANTS\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "SELECT first_name, last_name, count() AS credits\nFROM imdb.roles\nINNER JOIN imdb.actors ON imdb.actors.id = imdb.roles.actor_id\nWHERE lower(first_name) = lower('JACK')\n  AND lower(last_name) = lower('DAWSON')\nGROUP BY first_name, last_name ORDER BY credits DESC LIMIT 5": [["Jack", "Dawson", 3]], "SELECT first_name, last_name, count() AS credits\nFROM imdb.roles\nINNER JOIN imdb.actors ON imdb.actors.id = imdb.roles.actor_id\nWHERE lower(first_name) = lower('MARIA')\n  AND lower(last_name) = lower('SOLBERG')\nGROUP BY first_name, last_name ORDER BY credits DESC LIMIT 5": [], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bBlue\\\\s+Sun\\\\s+Corporation\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bWetherspoons\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "SELECT name, year, rank, lower(name) = lower('THE GATHERING') AS exact\nFROM imdb.movies\nWHERE positionCaseInsensitive(name, 'THE GATHERING') > 0 AND year > 1800\nORDER BY exact DESC, rank DESC, year DESC LIMIT 6": [["Magic the Gathering: Battlegrounds", 2003, 0.0, 0], ["McAllister Affair: The Gathering", 2002, 0.0, 0], ["Children of the Corn IV: The Gathering", 1996, 0.0, 0], ["Babylon 5: The Gathering", 1993, 0.0, 0]], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bEaling\\\\s+Studios\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "extract:6e3c151015794c8008aa080d9fdfbc3a": [{"text": "THE LEAKY BUCKET", "kind": "organisation", "context": "INT. THE LEAKY BUCKET - NIGHT"}, {"text": "TOM HANKS", "kind": "person", "context": "TOM HANKS sits alone."}, {"text": "COCA-COLA", "kind": "organisation", "context": "a bottle of COCA-COLA"}, {"text": "JURASSIC PARK", "kind": "title", "context": "paperback: JURASSIC PARK."}, {"text": "Nike", "kind": "organisation", "context": "Nike called again."}], "prom:Coca-Cola|Jurassic_Park|Nike|The_Leaky_Bucket|Tom_Hanks": [["Nike", 532419, 145], ["Coca-Cola", 2419120, 137], ["Tom_Hanks", 5481716, 107], ["Jurassic_Park", 2273657, 59]], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bTHE\\\\s+LEAKY\\\\s+BUCKET\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [], "SELECT first_name, last_name, count() AS credits\nFROM imdb.roles\nINNER JOIN imdb.actors ON imdb.actors.id = imdb.roles.actor_id\nWHERE lower(first_name) = lower('TOM')\n  AND lower(last_name) = lower('HANKS')\nGROUP BY first_name, last_name ORDER BY credits DESC LIMIT 5": [["Tom", "Hanks", 97]], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bCOCA\\\\-COLA\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [["Coca-Cola", 3660000, 627], ["Coca-Cola Egypt", 199000, 9], ["Coca-Cola \u0420\u043e\u0441\u0441\u0438\u044f", 132000, 22], ["Industria Mexicana de Coca-Cola", 132000, 25], ["Coca-Cola Pakistan", 118000, 12]], "SELECT name, year, rank, lower(name) = lower('JURASSIC PARK') AS exact\nFROM imdb.movies\nWHERE positionCaseInsensitive(name, 'JURASSIC PARK') > 0 AND year > 1800\nORDER BY exact DESC, rank DESC, year DESC LIMIT 6": [], "SELECT uploader, max(uploader_sub_count) AS subs, count() AS videos\nFROM youtube.youtube\nWHERE toStartOfMonth(upload_date) >= toDate('2021-07-01')\n  AND match(uploader, '(?i)\\\\bNike\\\\b')\nGROUP BY uploader HAVING subs > 0 ORDER BY subs DESC LIMIT 5": [["Nike", 1670000, 98], ["Nike Futebol", 362000, 3], ["NIKE channel", 166000, 3], ["Shiny Nike", 156000, 279], ["Fans nike ardilla", 74800, 84]]}